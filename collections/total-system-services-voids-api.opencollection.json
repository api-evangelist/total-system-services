{
  "opencollection": "1.0.0",
  "info": {
    "name": "TSYS Issuing Platform Accounts Voids API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Voids",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Void Transaction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://issuing.api.tsys.com/v1/transactions/:transactionId/void",
            "params": [
              {
                "name": "transactionId",
                "value": "",
                "type": "path",
                "description": "The transaction ID to void"
              }
            ]
          },
          "docs": "Void an authorized or captured transaction before settlement."
        }
      ]
    }
  ],
  "bundled": true
}